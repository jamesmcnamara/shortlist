DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://your-endpoint.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=at-least-32-characters-long

TMDB_API_READ_ACCESS_TOKEN=your-tmdb-read-access-token
MDB_API_KEY=your-mdblist-api-key

# Web Push: generate once with npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
