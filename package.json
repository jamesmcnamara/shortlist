{
  "name": "movie-shortlist",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next",
    "predev": "rm -f public/sw.js public/sw.js.map",
    "dev": "PORT=3030 next dev",
    "dev:clean": "npm run clean && npm run dev",
    "dev:sync": "node scripts/dev-sync.mjs",
    "dev:seed": "node scripts/dev-sync.mjs --seed-only",
    "build": "next build --webpack",
    "start": "next start",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "lint:css": "stylelint \"app/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "npm run neon:dev; npm run db:migrate",
    "db:migrate:prod": "npm run neon:prod; npm run db:migrate; npm run neon:dev",
    "db:migrate": "node --env-file=.env.local ./scripts/migrate.mjs",
    "data:oscars": "node scripts/update-oscar-data.mjs",
    "neon:prod": "neonctl checkout production",
    "neon:dev": "neonctl checkout dev"
  },
  "dependencies": {
    "@lorenzopant/tmdb": "^1.25.0",
    "@neondatabase/serverless": "^1.0.2",
    "@serwist/next": "^9.5.12",
    "@types/lodash": "^4.17.24",
    "better-auth": "~1.4.22",
    "canvas-confetti": "^1.9.4",
    "cheerio": "^1.2.0",
    "classnames": "^2.5.1",
    "drizzle-orm": "^0.44.2",
    "fp-ts": "^2.16.11",
    "lodash": "^4.18.1",
    "motion": "^12.43.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serwist": "^9.5.12",
    "shades": "^2.2.2",
    "swr": "^2.3.6",
    "use-debounce": "^10.1.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@electric-sql/pglite": "^0.5.4",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.1",
    "jsdom": "^30.0.1",
    "neonctl": "^3.6.0",
    "postcss": "^8.5.31",
    "postcss-custom-media": "^12.0.3",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.6.1",
    "prettier": "^3.9.10",
    "stylelint": "^17.15.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
